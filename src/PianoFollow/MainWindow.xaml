<Window x:Class="PianoFollow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PianoFollow"
        Title="Piano Follow · 钢琴跟谱" Icon="Assets/PianoFollow.ico" Width="1220" Height="820"
        MinWidth="1000" MinHeight="680" Background="#F1F5F4" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#142C2C"
        PreviewKeyDown="HandleShortcut" Closed="CloseWindow">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#F2F8F6"/>
            <Setter Property="Foreground" Value="#163F3B"/>
            <Setter Property="BorderBrush" Value="#C9DDD7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".46"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#12685A"/>
            <Setter Property="BorderBrush" Value="#12685A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,15,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#112D30" Padding="30,10">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="P I A N O   F O L L O W" Foreground="#83C9B4" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="钢琴跟谱" Foreground="#F5FCFA" FontSize="27" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="离线音频识谱" Foreground="#C7E2DB" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="OpenButton" Content="导入钢琴曲" Click="OpenAudio" Style="{StaticResource Primary}" ToolTip="Ctrl+O"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#FCFEFD" BorderBrush="#D8E5E1" BorderThickness="0,0,0,1" Padding="30,11">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="取消识别" Visibility="Collapsed" Click="CancelAnalysis" Margin="0,0,8,0"/>
                        <Button x:Name="ExportButton" Content="导出简谱" Click="ExportScore" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="SongTitle" Text="选择一首钢琴曲" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusText" Text="支持 WAV、MP3、FLAC、M4A 等本地音频 · 最长 15 分钟"
                                   Foreground="#516963" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="AnalysisProgress" Visibility="Collapsed" Height="4" Maximum="100"
                             Foreground="#20876F" Background="#E0EEEA" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="27,10,27,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,9">
                <StackPanel x:Name="ScoreSettingsPanel" Orientation="Horizontal" IsEnabled="False" VerticalAlignment="Center">
                    <TextBlock Text="1 =" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TonicBox" Width="66" Style="{StaticResource Field}" AutomationProperties.Name="简谱主音"/>
                    <TextBlock Text="拍号" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MeterBox" Width="60" SelectedIndex="2" Style="{StaticResource Field}" AutomationProperties.Name="拍号">
                        <ComboBoxItem Content="2/4" /><ComboBoxItem Content="3/4"/><ComboBoxItem Content="4/4"/>
                    </ComboBox>
                    <TextBlock Text="BPM" VerticalAlignment="Center"/>
                    <TextBox x:Name="BpmBox" Width="59" Text="100" Style="{StaticResource Field}" AutomationProperties.Name="每分钟拍数"/>
                    <TextBlock Text="首拍偏移（秒）" VerticalAlignment="Center"/>
                    <TextBox x:Name="OffsetBox" Width="65" Text="0" Style="{StaticResource Field}" AutomationProperties.Name="首拍偏移秒数"/>
                    <Button x:Name="ApplyScoreButton" Content="应用" Click="ApplySettings"/>
                    <Button Content="恢复估计" Click="RestorePulse" Margin="7,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="谱面缩放" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ScoreZoomBox" Width="66" SelectedIndex="1" SelectionChanged="ScoreZoomChanged"
                              Style="{StaticResource Field}" AutomationProperties.Name="谱面缩放">
                        <ComboBoxItem Content="65%" Tag="0.65"/>
                        <ComboBoxItem Content="80%" Tag="0.8"/>
                        <ComboBoxItem Content="100%" Tag="1"/>
                    </ComboBox>
                    <CheckBox x:Name="FollowCheck" Content="自动跟谱" IsChecked="True" Checked="FollowChanged"
                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" CornerRadius="9" Background="#FFFFFF" BorderBrush="#D1DFDB" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ScoreList" BorderThickness="0" Background="Transparent" SizeChanged="ScoreSizeChanged"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="ScoreScrolled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item"
                             VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="滚动简谱">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:ScoreLineView Line="{Binding}"
                                    Playhead="{Binding Position, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SeekRequested="SeekScore" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                        <TextBlock Text="01    导入音频" Foreground="#167666" FontSize="13" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="把琴声变成能跟着弹的简谱" FontSize="25" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="识别后可降速练习。点击谱面即可定位，播放时会高亮当前音符。"
                                   Foreground="#54716B" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Button Content="选择音频文件" Click="OpenAudio" HorizontalAlignment="Center"
                                Style="{StaticResource Primary}" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Foreground="#55706B" FontSize="11" Margin="2,7,0,0" TextWrapping="Wrap"
                Text="一 / 两条下划线表示八分 / 十六分音符 · 短横延一拍 · 上下点表示八度 · 0 为休止 · 高低音以中央 C 划分"/>
        </Grid>
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#D4E4DF" BorderThickness="0,1,0,0" Padding="29,10,29,13">
            <Grid x:Name="TransportPanel" IsEnabled="False">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Width="94" Content="▶ 播放" Click="TogglePlay" Style="{StaticResource Primary}" ToolTip="空格键 播放 / 暂停"/>
                <Grid Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTime" Text="00:00" VerticalAlignment="Center" FontSize="12"/>
                    <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            ValueChanged="SlideChanged" Margin="10,0" VerticalAlignment="Center"
                            AutomationProperties.Name="播放进度" />
                    <TextBlock x:Name="TotalTime" Grid.Column="2" Text="00:00" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="速度" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SpeedBox" Width="67" SelectedIndex="3" SelectionChanged="ChangeSpeed"
                              Style="{StaticResource Field}" AutomationProperties.Name="播放速度">
                        <ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="0.65×" Tag="0.65"/>
                        <ComboBoxItem Content="0.8×" Tag="0.8"/><ComboBoxItem Content="1.0×" Tag="1"/>
                        <ComboBoxItem Content="1.25×" Tag="1.25"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
